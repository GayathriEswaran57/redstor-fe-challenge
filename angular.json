{
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "redstor-gallery-card": {
      "projectType": "library",
      "root": "projects/redstor-gallery-card",
      "sourceRoot": "projects/redstor-gallery-card/src",
      "prefix": "lib",
      "targets": {
        "build": {
          "executor": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/redstor-gallery-card/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/redstor-gallery-card/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/redstor-gallery-card/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "executor": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/redstor-gallery-card/tsconfig.spec.json",
            "polyfills": ["zone.js", "zone.js/testing"]
          }
        }
      },
      "name": "redstor-gallery-card"
    }
  },
  "cli": {
    "analytics": false
  }
}
